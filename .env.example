# ==============================================================================
# Lupin AI — Environment Variables & Configuration
# ==============================================================================

# --- AI & LLM PROVIDER CONFIGURATION ---
# Required for Gemini model inference & synthetic dataset validation.
# In Google AI Studio, this is automatically injected at runtime.
GEMINI_API_KEY="your_gemini_api_key_here"

# --- APPLICATION ENVIRONMENT ---
# Hosted application URL (Cloud Run service URL, custom domain, or localhost:3000)
APP_URL="https://ais-dev-k2z3mugx6ozezmoozcheau-487983914118.europe-west2.run.app"
NODE_ENV="development"
PORT=3000

# --- TELEGRAM BOT VERIFICATION (Zero-Cost Manual Review Flow) ---
# Create your bot token for free via @BotFather on Telegram.
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"

# The chat ID of your private admin reviewer group/channel (starts with -100...)
# Retrieve by adding @userinfobot or @RawDataBot to your private Telegram group.
TELEGRAM_ADMIN_GROUP_ID="-1001234567890"

# --- STUDENT VERIFICATION & PAYOUT CONFIGURATION ---
# Default disbursement interval for reviewed and approved tasks
PAYOUT_SCHEDULE_DAY="Friday"
PAYOUT_SCHEDULE_TIME="17:00"
DEFAULT_COMPUTE_CREDITS_BONUS=1000

# --- OPTIONAL VITE CLIENT-SIDE EXPOSED VARIABLES ---
# Variables prefixed with VITE_ are accessible inside client browser code:
VITE_APP_NAME="Lupin AI"
VITE_ENABLE_COMMUNITY_FORUMS="true"
VITE_TELEGRAM_SUPPORT_BOT="@LupinAIVerifyBot"
